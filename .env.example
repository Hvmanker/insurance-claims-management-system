# Copy to `.env` and replace placeholder values before `docker compose up`.
# Do not commit `.env` (it is gitignored).

POSTGRES_DB=claims
POSTGRES_USER=claims
POSTGRES_PASSWORD=replace-with-strong-postgres-password

REDIS_PASSWORD=replace-with-strong-redis-password

DB_URL=jdbc:postgresql://postgres:5432/claims
DB_USERNAME=claims
DB_PASSWORD=replace-with-strong-postgres-password

REDIS_HOST=redis

KAFKA_BOOTSTRAP_SERVERS=kafka:9092

SPRING_PROFILES_ACTIVE=demo
DEMO_AGENT_PASSWORD=replace-with-strong-demo-agent-password
DEMO_INSURED_PASSWORD=replace-with-strong-demo-insured-password
