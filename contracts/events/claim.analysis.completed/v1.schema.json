{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "claim.analysis.completed v1",
  "allOf": [
    {
      "$ref": "../../envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "claim.analysis.completed"
        },
        "schemaVersion": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "claimId",
            "extracted",
            "flags",
            "parserVersion",
            "modelVersion"
          ],
          "properties": {
            "claimId": {
              "type": "string",
              "format": "uuid"
            },
            "extracted": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "estimateNumber",
                "repairShopName",
                "dateOfLoss",
                "lineItems",
                "estimateTotal"
              ],
              "properties": {
                "estimateNumber": {
                  "$ref": "#/$defs/stringField"
                },
                "repairShopName": {
                  "$ref": "#/$defs/stringField"
                },
                "dateOfLoss": {
                  "$ref": "#/$defs/stringField"
                },
                "lineItems": {
                  "$ref": "#/$defs/lineItemsField"
                },
                "estimateTotal": {
                  "$ref": "#/$defs/moneyField"
                }
              }
            },
            "flags": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "AMOUNT_MISMATCH",
                  "DATE_MISALIGNED",
                  "DUPLICATE_ESTIMATE_NUMBER",
                  "LINE_ITEM_OUTLIER",
                  "UNREADABLE_DOCUMENT",
                  "SUSPECTED_INSTRUCTION_IN_DOCUMENT"
                ]
              },
              "uniqueItems": true
            },
            "parserVersion": {
              "type": "string",
              "minLength": 1
            },
            "modelVersion": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "textSpan"],
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "textSpan": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stringField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence", "evidence"],
      "properties": {
        "value": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "lineItemsField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence", "evidence"],
      "properties": {
        "value": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description", "amount"],
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "amount": {
                "type": "string",
                "pattern": "^\\d+(\\.\\d{1,2})?$"
              }
            }
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "moneyField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence", "evidence"],
      "properties": {
        "value": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amount", "currency"],
          "properties": {
            "amount": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d{1,2})?$"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    }
  }
}
